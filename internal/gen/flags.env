# Build flags of `make generate` (part of the pinned inputs). BENCHMARKS.md ("Build flags") has
# the measurements behind each choice:
#  -flto            link-time optimization: -8 % encode, -3 % decode time vs without
#  encoder -O3      fastest: -O2 is 5-7 % slower (0.7 MB smaller), -Os 26-31 %, -Oz 38-46 %
#  decoder -O2      as fast as -O3 and 0.28 MB smaller; -Os is 2-5 % slower, -Oz 32-37 %
#  -mnontrapping-fptoint -mbulk-memory -msign-ext   Wasm features wasm2go translates to plain Go
#                   (bulk memory makes memcpy/memset a Go copy/clear)
#  wasm2go -unsafe  unsafe-based loads and stores (still bounds checked): 8-15 % faster
COMMON="-flto -mnontrapping-fptoint -mbulk-memory -msign-ext"
DEC_CFLAGS="-O2 $COMMON"
DEC_LDFLAGS="-flto -Wl,--lto-O2"
ENC_CFLAGS="-O3 $COMMON"
ENC_LDFLAGS="-flto -Wl,--lto-O3"
WASM2GO_FLAGS="-unsafe"
