# Build flags of `make generate` (part of the pinned inputs; BENCHMARKS.md has the measurements
# behind each choice).
#  -O3 -flto        fastest measured (LTO: -8 % encode, -3 % decode vs -O3 alone; -O2 is slower)
#  -mnontrapping-fptoint -mbulk-memory -msign-ext   Wasm features wasm2go translates to plain Go
#                   (bulk memory makes memcpy/memset a Go copy/clear)
#  wasm2go -unsafe  unsafe-based loads and stores (still bounds checked): -8 to -15 %
CFLAGS="-O3 -flto -mnontrapping-fptoint -mbulk-memory -msign-ext"
LDFLAGS="-flto -Wl,--lto-O3"
WASM2GO_FLAGS="-unsafe"
